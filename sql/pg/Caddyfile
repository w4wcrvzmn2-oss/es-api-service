# Path on server: D:\Caddy\Caddyfile
# es_api: 8080 = ClientWeb, 8081 = ClienElf2

{
	email admin@24pharmdata.ru
	# HTTP/1.1 only (this Caddy build: h1, h2, h2c, h3 — no h1c)
	servers {
		protocols h1
	}
}

(proxy_api) {
	# Real client IP for Go rate limits / login lockout
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Proto {scheme}
}

24pharmdata.ru {
	reverse_proxy 127.0.0.1:8080 {
		import proxy_api
	}
}

www.24pharmdata.ru {
	redir https://24pharmdata.ru{uri} permanent
}

phd.24pharmdata.ru {
	reverse_proxy 127.0.0.1:8081 {
		import proxy_api
	}
}

git.24pharmdata.ru {
	reverse_proxy 127.0.0.1:3000 {
		import proxy_api
	}
}

# No public site on bare origin IP — use domain names only.
